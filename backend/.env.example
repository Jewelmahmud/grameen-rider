# Server Configuration
NODE_ENV=production
PORT=3000
SOCKET_IO_PORT=3001

# GiLab Auth Server (grameenauthserver/docs/authserver.md)
# Origin only (no path). Default endpoint paths are appended to it.
AUTH_SERVER_URL=https://auth.grameenbazaar.com
AUTH_SERVER_TIMEOUT=5000
# Issued by the GiLab team for Grameen Ride. Required in production (else 400 MISSING_APPLICATION_ID).
GILAB_APPLICATION_ID=
# Server-side only, never sent to a browser. With the app id it makes GiLab rate-limit logins per
# end user instead of per our server IP (GiLab must list the app in TRUSTED_SERVER_APPLICATION_IDS).
GILAB_CLIENT_SECRET=
# Company that self-registered Grameen Ride users belong to (required by /api/v1/registration).
GRAMEEN_RIDE_COMPANY_ID=
# Token checks (defaults shown). Tokens are verified with POST /oauth/introspect, not a shared secret.
# GILAB_TOKEN_ISSUER=grameen-auth-server
# GILAB_TOKEN_AUDIENCE=grameen-applications
# Optional per-endpoint overrides: AUTH_SERVER_<KEY>_PATH or AUTH_SERVER_<KEY>_URL, where KEY is
# LOGIN, SEND_OTP, REGISTRATION, VERIFY_PHONE, RESEND_VERIFICATION, REFRESH, LOGOUT, INTROSPECT, ME.
# Set when running behind a proxy/load balancer so the real client IP reaches GiLab (e.g. 1 or loopback).
TRUST_PROXY=

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/grameenride
# Development uses TypeORM synchronize. Staging/production: run migrations on start.
DB_RUN_MIGRATIONS=true
# DB_SYNCHRONIZE=false   # turn synchronize off in development too
DB_POOL_SIZE=20
DB_IDLE_TIMEOUT=30000
DB_STATEMENT_TIMEOUT=30000

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password
REDIS_TTL=3600

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=grameen-ride-service
KAFKA_GROUP_ID=ride-service-group
KAFKA_RETRY_ATTEMPTS=3

# FCM
FCM_SERVER_KEY=your-fcm-server-key
FCM_PROJECT_ID=your-fcm-project-id

# BulkSMSBD
BULKSMSBD_ENABLED=false
BULKSMSBD_API_URL=https://bulksmsbd.com/api/smsapi
BULKSMSBD_API_KEY=your-bulksmsbd-api-key
BULKSMSBD_SENDER_ID=your-sender-id
BULKSMSBD_CLIENT_ID=your-client-id

# Payment Gateways
BKASH_API_URL=https://api.bkash.com
BKASH_API_KEY=your-bkash-key
BKASH_SECRET_KEY=your-bkash-secret
BKASH_TIMEOUT=30000

NAGAD_API_URL=https://api.nagad.com
NAGAD_API_KEY=your-nagad-key
NAGAD_SECRET_KEY=your-nagad-secret

# PortPos
PORTPOS_API_KEY=your-portpos-api-key
PORTPOS_INIT_URL=https://api.portpos.com/payment/init
PORTPOS_VERIFY_URL=https://api.portpos.com/payment/verify

# SSLCommerz
SSLCOMMERZ_STORE_ID=your-sslcommerz-store-id
SSLCOMMERZ_STORE_PASSWORD=your-sslcommerz-store-password
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_SUCCESS_URL=http://localhost:5006/api/payments/webhook/sslcommerz
SSLCOMMERZ_FAIL_URL=http://localhost:5006/api/payments/webhook/sslcommerz
SSLCOMMERZ_CANCEL_URL=http://localhost:5006/api/payments/webhook/sslcommerz
SSLCOMMERZ_IPN_URL=http://localhost:5006/api/payments/webhook/sslcommerz

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
STRICT_RATE_LIMIT_MAX_REQUESTS=10

# Circuit Breaker
CIRCUIT_BREAKER_TIMEOUT=5000
CIRCUIT_BREAKER_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT=30000

# Monitoring
SENTRY_DSN=your-sentry-dsn
PROMETHEUS_PORT=9090
METRICS_PREFIX=grameen_ride

# Security
JWT_SECRET=your-jwt-secret
API_RATE_LIMIT=100
CORS_ORIGIN=https://yourapp.com
HELMET_ENABLED=true

# Background Jobs
REDIS_QUEUE_URL=redis://localhost:6379
JOB_CONCURRENCY=5
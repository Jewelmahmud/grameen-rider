# Server Configuration
NODE_ENV=production
PORT=3000
SOCKET_IO_PORT=3001

# Auth Server Integration
AUTH_SERVER_URL=https://auth-server.example.com
AUTH_SERVER_VALIDATE_ENDPOINT=/api/auth/validate
AUTH_SERVER_URL=https://auth.grameenbazaar.com/oauth/login
AUTH_SERVER_REGISTRATION_URL=https://auth.grameenbazaar.com/api/v1/registration
AUTH_SERVER_JWT_SECRET=your-jwt-secret
AUTH_SERVER_API_KEY=your-api-key
AUTH_SERVER_TIMEOUT=5000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/grameenride
DB_POOL_SIZE=20
DB_IDLE_TIMEOUT=30000
DB_STATEMENT_TIMEOUT=30000

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password
REDIS_TTL=3600

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=grameen-ride-service
KAFKA_GROUP_ID=ride-service-group
KAFKA_RETRY_ATTEMPTS=3

# FCM
FCM_SERVER_KEY=your-fcm-server-key
FCM_PROJECT_ID=your-fcm-project-id

# BulkSMSBD
BULKSMSBD_ENABLED=false
BULKSMSBD_API_URL=https://bulksmsbd.com/api/smsapi
BULKSMSBD_API_KEY=your-bulksmsbd-api-key
BULKSMSBD_SENDER_ID=your-sender-id
BULKSMSBD_CLIENT_ID=your-client-id

# Payment Gateways
BKASH_API_URL=https://api.bkash.com
BKASH_API_KEY=your-bkash-key
BKASH_SECRET_KEY=your-bkash-secret
BKASH_TIMEOUT=30000

NAGAD_API_URL=https://api.nagad.com
NAGAD_API_KEY=your-nagad-key
NAGAD_SECRET_KEY=your-nagad-secret

# PortPos
PORTPOS_API_KEY=your-portpos-api-key
PORTPOS_INIT_URL=https://api.portpos.com/payment/init
PORTPOS_VERIFY_URL=https://api.portpos.com/payment/verify

# SSLCommerz
SSLCOMMERZ_STORE_ID=your-sslcommerz-store-id
SSLCOMMERZ_STORE_PASSWORD=your-sslcommerz-store-password
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_SUCCESS_URL=http://localhost:5006/api/payments/webhook/sslcommerz
SSLCOMMERZ_FAIL_URL=http://localhost:5006/api/payments/webhook/sslcommerz
SSLCOMMERZ_CANCEL_URL=http://localhost:5006/api/payments/webhook/sslcommerz
SSLCOMMERZ_IPN_URL=http://localhost:5006/api/payments/webhook/sslcommerz

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
STRICT_RATE_LIMIT_MAX_REQUESTS=10

# Circuit Breaker
CIRCUIT_BREAKER_TIMEOUT=5000
CIRCUIT_BREAKER_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT=30000

# Monitoring
SENTRY_DSN=your-sentry-dsn
PROMETHEUS_PORT=9090
METRICS_PREFIX=grameen_ride

# Security
JWT_SECRET=your-jwt-secret
API_RATE_LIMIT=100
CORS_ORIGIN=https://yourapp.com
HELMET_ENABLED=true

# Background Jobs
REDIS_QUEUE_URL=redis://localhost:6379
JOB_CONCURRENCY=5
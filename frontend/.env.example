VITE_API_BASE_URL=http://localhost:5006/api
# Map tiles and address search. Defaults: OpenStreetMap tiles and public Nominatim (fine for development;
# use your own tile server / geocoder in production, public Nominatim allows ~1 request per second).
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_GEOCODER_URL=https://nominatim.openstreetmap.org
# Driver app download link shown to drivers after sign-up (/driver). Empty = "ask support" message.
# VITE_DRIVER_APP_URL=
# GiLab's own account page where users change their password (shown on /forgot-password when set).
# VITE_GILAB_ACCOUNT_URL=

# ==========================================
# Grameen Ride Monorepo .gitignore
# ==========================================

# Environment variables & secrets (keep .env.example)
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Editor files
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Logs and runtime data
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/

# Coverage and test artifacts
coverage/
.nyc_output/

# ==========================================
# Node.js & Frontend (NestJS / React / Vite)
# ==========================================
node_modules/
dist/
dist-ssr/
.vite/
.vite-temp/
.turbo/
*.tsbuildinfo

# ==========================================
# Flutter & Dart (mobile/user & mobile/rider)
# ==========================================
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies

# Symbolication and Obfuscation
app.*.symbols
app.*.map.json

# Generated code files (if generated by build_runner)
*.g.dart
*.freezed.dart

# Android build & secrets
**/android/.gradle/
**/android/captures/
**/android/gradleBuild/
**/android/**/build/
**/android/app/debug
**/android/app/profile
**/android/app/release
**/android/local.properties
**/android/key.properties
**/*.keystore
**/*.jks

# iOS build & pods
**/ios/**/Pods/
**/ios/.symlinks/
**/ios/Flutter/.last_build_id
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3

# Desktop ephemeral artifacts
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/
**/macos/Flutter/ephemeral/
